AppMetrics
| where TimeGenerated between (ago(15m) .. now())
| where Name == "sharepoint.file.upload.duration"
| where tostring(Properties["probe.service"]) == "sharepoint"
| where tostring(Properties["probe.mode"]) == "live"
| summarize DurationSeconds = sum(Sum), Requests = sum(ItemCount) by _ResourceId
| where Requests > 0
| project _ResourceId, MeanUploadSeconds = DurationSeconds / Requests
