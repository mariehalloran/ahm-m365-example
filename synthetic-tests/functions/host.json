{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*,5.0.0)"
  },
  "extensions": {
    "durableTask": {
      "tracing": { "traceInputsAndOutputs": false },
      "maxConcurrentActivityFunctions": 10,
      "maxConcurrentOrchestratorFunctions": 10,
      "storageProvider": { "connectionName": "AzureWebJobsStorage" }
    },
    "http": { "routePrefix": "api" }
  },
  "logging": {
    "logLevel": { "default": "Information", "Host.Results": "Information" },
    "applicationInsights": { "samplingSettings": { "isEnabled": false } }
  }
}
