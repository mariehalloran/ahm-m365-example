{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*,5.0.0)"
  },
  "extensions": {
    "durableTask": {
      "hubName": "%DURABLE_TASK_HUB%",
      "tracing": { "traceInputsAndOutputs": false },
      "maxConcurrentActivityFunctions": 10,
      "maxConcurrentOrchestratorFunctions": 10,
      "storageProvider": { "connectionName": "AzureWebJobsStorage" }
    },
    "http": { "routePrefix": "api" }
  },
  "logging": {
    "logLevel": {
      "default": "Information",
      "Host.Results": "Information",
      "Azure.Core": "Warning",
      "Azure.Identity": "Warning"
    },
    "applicationInsights": { "samplingSettings": { "isEnabled": false } }
  }
}
