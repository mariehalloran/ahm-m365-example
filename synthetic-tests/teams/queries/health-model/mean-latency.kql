AppMetrics
| where _ResourceId =~ "__APPLICATION_INSIGHTS_RESOURCE_ID__"
| where TimeGenerated between (ago(5m) .. now())
| where Name == "teams.message.publication.duration"
| where tostring(Properties["probe.service"]) == "teams" and tostring(Properties["probe.mode"]) == "live"
| where tostring(Properties["probe.journey"]) == "publish-channel-message"
| summarize DurationSeconds = sum(Sum), Samples = sum(ItemCount)
| where Samples > 0
| project Value = 1000.0 * DurationSeconds / Samples
