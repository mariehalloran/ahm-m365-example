AppMetrics
| where _ResourceId =~ "__APPLICATION_INSIGHTS_RESOURCE_ID__"
| where TimeGenerated between (ago(5m) .. now())
| where Name == "synthetic.step.success"
| where tostring(Properties["probe.service"]) == "teams" and tostring(Properties["probe.mode"]) == "live"
| where tostring(Properties["probe.journey"]) == "publish-channel-message" and tostring(Properties["probe.step"]) == "__STEP__"
| summarize Successful = sum(Sum), Attempts = sum(ItemCount)
| where Attempts > 0
| project Value = 100.0 * Successful / Attempts
