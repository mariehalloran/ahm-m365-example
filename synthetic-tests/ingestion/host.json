{
  "version": "2.0",
  "functionTimeout": "00:02:00",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.0.0, 5.0.0)"
  },
  "extensions": {
    "eventHubs": {
      "maxEventBatchSize": 500,
      "prefetchCount": 1000,
      "batchCheckpointFrequency": 1,
      "initialOffsetOptions": { "type": "fromStart" }
    }
  },
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Function.ingestObservations": "Information"
    },
    "applicationInsights": {
      "samplingSettings": { "isEnabled": false }
    }
  }
}
