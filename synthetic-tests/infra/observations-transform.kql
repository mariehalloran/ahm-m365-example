source
| extend parsed = parse_json(RawData)
| project
    TimeGenerated = todatetime(parsed.timestamp),
    Timestamp = todatetime(parsed.timestamp),
    EventId = tostring(parsed.eventId),
    Category = tostring(parsed.category),
    Subject = tostring(parsed.subject),
    Period = tostring(parsed.period),
    Unit = tostring(parsed.unit),
    Version = tostring(parsed.version),
    Value = iff(tostring(parsed.dimensions.failureCategory) in ('cancelled', 'cleanup-failure'), real(null), todouble(parsed.value)),
    Service = tostring(parsed.dimensions.service),
    Journey = tostring(parsed.dimensions.journey),
    Step = tostring(parsed.dimensions.step),
    Kind = tostring(parsed.dimensions["kind"]),
    Mode = tostring(parsed.dimensions.mode),
    Region = tostring(parsed.dimensions.region),
    ExecutionRegion = tostring(parsed.dimensions.executionRegion),
    M365TenantId = tostring(parsed.dimensions.tenantId),
    TenantAlias = tostring(parsed.dimensions.tenantAlias),
    TestAccountId = tostring(parsed.dimensions.testAccountId),
    SyntheticUser = tostring(parsed.dimensions.syntheticUser),
    GroupIds = parsed.dimensions.reportingGroupIds,
    GroupNames = parsed.dimensions.reportingGroupNames,
    DurationMs = todouble(parsed.dimensions.durationMs),
    FailureCategory = tostring(parsed.dimensions.failureCategory),
    ErrorMessage = tostring(parsed.dimensions.errorMessage),
    HttpStatus = toint(parsed.dimensions.httpStatus),
    RunId = tostring(parsed.dimensions.runId),
    CorrelationId = tostring(parsed.dimensions.correlationId),
    Dimensions = parsed.dimensions
