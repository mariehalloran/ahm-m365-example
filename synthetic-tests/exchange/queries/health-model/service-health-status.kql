AppTraces
| where _ResourceId =~ "__APPLICATION_INSIGHTS_RESOURCE_ID__"
| where TimeGenerated between (ago(15m) .. now())
| where Message == "m365-service-health-overview"
| where tostring(Properties["provider.service"]) == "exchange" and tostring(Properties["provider.mode"]) == "live"
| where tostring(Properties["provider.api_version"]) == "v1.0"
| where todatetime(Properties["provider.collected_at"]) between (ago(15m) .. now())
| summarize arg_max(TimeGenerated, Properties)
| extend SourceStatus = tostring(Properties["provider.status"])
| extend Value = case(
    SourceStatus in ("serviceOperational", "serviceRestored", "resolved", "resolvedExternal", "falsePositive", "postIncidentReviewPublished"), 100.0,
    SourceStatus == "serviceInterruption", 0.0,
    SourceStatus in ("serviceDegradation", "investigating", "restoringService", "verifyingService", "extendedRecovery", "investigationSuspended", "mitigated", "mitigatedExternal", "confirmed", "reported"), 50.0,
    real(null))
| where isnotnull(Value)
| project Value, SourceStatus
