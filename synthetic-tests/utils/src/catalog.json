    {
      "service": "onedrive",
      "displayName": "OneDrive Experience",
      "journeys": [
        {
          "name": "user-drive-roundtrip",
          "entityName": "onedrive-planned-user-drive-roundtrip",
          "displayName": "Create, reopen, verify and delete user-drive file",
          "steps": [
            {
              "name": "step-1",
              "displayName": "Create owned folder and file in selected folder",
              "telemetryName": "create-folder-file"
            },
            {
              "name": "step-2",
              "displayName": "Enumerate and download owned file",
              "telemetryName": "reopen-file"
            },
            {
              "name": "step-3",
              "displayName": "Verify exact content hash",
              "telemetryName": "verify-file-hash"
            },
            {
              "name": "step-4",
              "displayName": "Delete owned artifacts and verify removal",
              "telemetryName": "delete-owned-artifacts"
            }
          ]
        },
        {
          "name": "app-folder-lifecycle",
          "entityName": "onedrive-planned-app-folder-lifecycle",
          "displayName": "Write, read, update and delete app-folder data",
          "steps": [
            {
              "name": "step-1",
              "displayName": "Create cycle-owned folder and app data",
              "telemetryName": "write-app-data"
            },
            {
              "name": "step-2",
              "displayName": "Read and verify data",
              "telemetryName": "read-app-data"
            },
            {
              "name": "step-3",
              "displayName": "Update, reread and verify persisted state",
              "telemetryName": "update-app-data"
            },
            {
              "name": "step-4",
              "displayName": "Delete cycle-owned folder and verify removal",
              "telemetryName": "delete-app-scratch"
            }
          ]
        },
        {
          "name": "document-versions",
          "entityName": "onedrive-planned-document-versions",
          "displayName": "Update document and retrieve prior version",
          "steps": [
            {
              "name": "step-1",
              "displayName": "Write and verify two document revisions",
              "telemetryName": "update-document"
            },
            {
              "name": "step-2",
              "displayName": "Enumerate actual document version history",
              "telemetryName": "list-versions"
            },
            {
              "name": "step-3",
              "displayName": "Download prior version and verify bytes",
              "telemetryName": "read-prior-version"
            },
            {
              "name": "step-4",
              "displayName": "Optional: restore downloaded prior bytes and verify",
              "telemetryName": "restore-version"
            }
          ]
        }
      ]
