{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": [
    "exchange/src/**/*.ts",
    "teams/src/**/*.ts",
    "onedrive/src/**/*.ts",
    "sharepoint/src/**/*.ts",
    "functions/src/**/*.ts",
    "coordinator/src/**/*.ts",
    "utils/src/**/*.ts"
  ]
}
