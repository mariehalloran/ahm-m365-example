{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": [
    "exchange/src/**/*.ts", "exchange/tests/**/*.ts",
    "teams/src/**/*.ts", "teams/tests/**/*.ts",
    "onedrive/src/**/*.ts", "onedrive/tests/**/*.ts",
    "utils/src/**/*.ts", "utils/tests/**/*.ts",
    "vitest.config.ts"
  ]
}
