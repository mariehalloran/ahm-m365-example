{
  "name": "m365-synthetic-health-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tenant-specific Microsoft 365 synthetics for Azure Monitor Health Models",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "npm run catalog:check && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc --project tsconfig.build.json",
    "typecheck": "npm run catalog:check && tsc --noEmit",
    "catalog:generate": "tsx utils/src/catalog-projection.ts",
    "catalog:check": "tsx utils/src/catalog-projection.ts --check",
    "exchange": "tsx exchange/src/worker.ts",
    "exchange:mail-test": "tsx exchange/src/mail-test-command.ts",
    "teams": "tsx teams/src/worker.ts",
    "onedrive": "tsx onedrive/src/worker.ts",
    "onedrive:setup": "tsx onedrive/src/setup-command.ts",
    "setup": "pwsh -NoProfile -File setup/setup.ps1",
    "deploy": "npm run catalog:check && tsx utils/src/deploy.ts"
  },
  "dependencies": {
    "@azure/identity": "^4.12.0",
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.44",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "jose": "^6.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
