{
  "name": "m365-synthetic-health-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tenant-specific Microsoft 365 synthetics for Azure Monitor Health Models",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "npm run catalog:check && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc --project tsconfig.build.json",
    "typecheck": "npm run catalog:check && tsc --noEmit",
    "catalog:generate": "tsx utils/src/catalog-projection.ts",
    "catalog:check": "tsx utils/src/catalog-projection.ts --check",
    "exchange": "tsx exchange/src/command.ts",
    "teams": "tsx teams/src/command.ts",
    "onedrive": "tsx onedrive/src/command.ts",
    "onedrive:setup": "pwsh -NoProfile -File setup/provision-onedrive.ps1",
    "sharepoint": "tsx sharepoint/src/command.ts",
    "coordinator": "tsx coordinator/src/index.ts",
    "functions:prepare-local": "npm run build && tsx functions/src/package-command.ts",
    "functions:start": "func start --script-root .function-package/local",
    "setup:ids": "pwsh -NoProfile -File setup/generate-ids.ps1",
    "setup:reply-seeds": "pwsh -NoProfile -File setup/provision-reply-seeds.ps1",
    "setup:function-auth": "pwsh -NoProfile -File setup/function-auth.ps1",
    "deploy": "npm run catalog:check && tsx utils/src/deployment/deploy.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.17.0",
    "@azure/identity": "^4.12.0",
    "@azure/monitor-ingestion": "^1.2.0",
    "@azure/storage-blob": "^12.34.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "durable-functions": "^3.6.0",
    "html-to-text": "^10.0.1",
    "jose": "^6.1.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
