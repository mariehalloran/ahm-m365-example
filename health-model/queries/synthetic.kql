M365Synthetic_CL
| where TimeGenerated > ago(__WINDOW__m) and TimeGenerated <= now()
| where Timestamp > ago(__WINDOW__m) and Timestamp <= now()
| where Category == 'M365Synthetic' and Version == '1' and Mode == 'live' and Unit == 'success'
| where Service == '__SERVICE__' and Journey == '__JOURNEY__'
| where Kind == '__KIND__' and Step == '__STEP__'
| where TenantAlias == '__TENANT__'
| where '__GROUP__' == '' or set_has_element(GroupIds, '__GROUP__')
| where Value in (0.0, 1.0) and isnotnull(DurationMs) and DurationMs >= 0
| summarize arg_max(Timestamp, *) by EventId
| summarize Samples = count(), Value = __AGGREGATION__
| where Samples >= __MINIMUM__ and isnotnull(Value)
| project Value
