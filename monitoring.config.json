{
  "schemaVersion": "1.0",
  "otel": { "enabled": false, "destination": "console" },
  "healthModel": {
    "name": "m365-experience-poc",
    "subscriptionId": "00000000-0000-0000-0000-000000000000",
    "resourceGroup": "rg-m365-demo",
    "reportTtlMinutes": 15,
    "successDegradedPercent": 99,
    "successUnhealthyPercent": 95,
    "latencyDegradedMilliseconds": 15000,
    "latencyUnhealthyMilliseconds": 60000
  },
  "services": {
    "exchange": {
      "enabled": true,
      "configFile": "synthetic-tests/exchange/config.json",
      "scenarios": {
        "send-receive-mail": true, "edit-reopen-draft": true,
        "attachment-reply-mail": true, "distribution-list-mail": true,
        "recurring-calendar": true, "meeting-invitation": true
      },
      "targets": [
        {
          "id": "exchange-probe-001",
          "mailbox": "dedicated-synthetic@example.invalid",
          "recipientMailbox": "dedicated-recipient@example.invalid",
          "distributionList": {
            "address": "dedicated-list@example.invalid",
            "expectedRecipients": ["dedicated-synthetic@example.invalid", "dedicated-recipient@example.invalid"]
          }
        }
      ]
    },
    "teams": {
      "enabled": true,
      "configFile": "synthetic-tests/teams/config.json",
      "scenarios": { "publish-channel-message": true, "reply-channel-message": true, "call-test-user": true },
      "targets": [
        {
          "id": "teams-probe-001",
          "tenantId": "00000000-0000-0000-0000-000000000000",
          "teamId": "00000000-0000-0000-0000-000000000000",
          "channelId": "replace-with-dedicated-standard-channel-id",
          "serviceUrl": "https://smba.trafficmanager.net/teams/"
        }
      ],
      "callTargets": [
        { "id": "teams-call-user-001", "tenantId": "00000000-0000-0000-0000-000000000000", "callUserId": "11111111-1111-4111-8111-111111111111" },
        { "id": "teams-call-user-002", "tenantId": "00000000-0000-0000-0000-000000000000", "callUserId": "22222222-2222-4222-8222-222222222222" },
        { "id": "teams-call-user-003", "tenantId": "00000000-0000-0000-0000-000000000000", "callUserId": "33333333-3333-4333-8333-333333333333" }
      ]
    },
    "sharepoint": {
      "enabled": true,
      "configFile": "synthetic-tests/sharepoint/config.json",
      "scenarios": { "save-reopen-file": true, "rename-reopen-file": true },
      "targets": [
        { "id": "sharepoint-probe-001" }
      ]
    }
  }
}
