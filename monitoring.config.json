{
  "schemaVersion": "2.0",
  "healthModel": {
    "name": "m365-experience-consto",
    "subscriptionId": "17a37fff-b1ef-4af7-9bd2-70898b286aaf",
    "resourceGroup": "rg-m365-consto",
    "reportTtlMinutes": 15,
    "successDegradedPercent": 99,
    "successUnhealthyPercent": 95,
    "latencyDegradedMilliseconds": 15000,
    "latencyUnhealthyMilliseconds": 60000
  },
  "deployment": {
    "location": "centralus",
    "enableLiveProbes": true,
    "enableBetaServiceActivity": true,
    "foundation": { "mode": "existing", "environment": "cae-m365-experience-consto", "registry": "crm365ctbcoagujf67a" },
    "image": { "mode": "build", "repository": "m365-synthetic", "tag": "monitoring" }
  },
  "otel": { "enabled": true, "destination": "azure-monitor" },
  "serviceHealth": { "enabled": true },
  "tenants": [{
    "id": "consto",
    "displayName": "Consto",
    "tenantId": "5e7897a0-4a38-43f3-914d-195d5355e969",
    "providerClientId": "a0bc7fcd-820f-4873-83b5-c7dd77ddad92",
    "services": {
      "exchange": {
        "enabled": true,
        "execution": {
          "mode": "live", "intervalSeconds": 60, "timeoutSeconds": 30, "cohort": "exchange-global",
          "maxConcurrentRequests": 32, "maxConcurrentRequestsPerMailbox": 2,
          "serviceHealth": true,
          "serviceActivity": {
            "enabled": true,
            "functions": [
              "getConnectivityMetricsForExchange",
              "getMessageVolumeMetricsForEmailDelivery",
              "getActiveUserMetricsForOutlookWebByReadEmail",
              "getActiveUserMetricsForOutlookWebByAppOpening",
              "getActiveUserMetricsForEmailByModernAuthentication"
            ]
          }
        },
        "worker": { "appName": "m365-ctbcoa-exchange", "identity": "uami-m365-experience-consto-exchange" },
        "scenarios": {
          "send-receive-mail": true, "edit-reopen-draft": true, "attachment-mail": true,
          "reply-mail": true, "recurring-calendar": true
        },
        "targets": [
          {
            "id": "exchange-probe-001", "mailbox": "test-user-1@constosuites.onmicrosoft.com"
          },
          {
            "id": "exchange-probe-002", "mailbox": "test-user-4@constosuites.onmicrosoft.com"
          },
          {
            "id": "exchange-probe-003", "mailbox": "test-user-5@constosuites.onmicrosoft.com"
          },
          {
            "id": "exchange-probe-004", "mailbox": "test-user-2@constosuites.onmicrosoft.com"
          }
        ]
      },
      "teams": {
        "enabled": true,
        "execution": {
          "mode": "live", "intervalSeconds": 120, "timeoutSeconds": 45, "cohort": "teams-global",
          "serviceHealth": true,
          "teamsCleanupEnabled": false,
          "teamsReadbackClientId": "417d47e9-6ef3-40de-a8af-ac15b5438d54",
          "executionLanes": [
            { "name": "teams", "intervalSeconds": 120, "timeoutSeconds": 45, "journeys": ["channel-conversation", "scheduled-meeting"] }
          ]
        },
        "access": { "bot": "bot-m365-consto", "peerBot": "ahm-m365-consto-peer", "peerIdentity": "uami-m365-experience-consto-teams-peer" },
        "worker": { "appName": "m365-ctbcoa-teams", "identity": "uami-m365-experience-consto-teams" },
        "scenarios": { "channel-conversation": true, "scheduled-meeting": true },
        "targets": [
          { "id": "teams-probe-001", "teamId": "df910f56-b46f-4411-9b77-bcf6474b13fc", "channelName": "General" },
          { "id": "teams-probe-002", "teamId": "df910f56-b46f-4411-9b77-bcf6474b13fc", "channelName": "United Kingdom Users" }
        ],
        "callTargets": [{
          "id": "teams-bot-meeting-001",
          "meetingThreadId": "19:meeting_ZTNkZGVlNTgtMmRiNC00ODY1LThhODAtZDY5MWM0YzI0YmNj@thread.v2",
          "organizer": "test-user-1@constosuites.onmicrosoft.com"
        }]
      },
      "onedrive": {
        "enabled": true,
        "execution": {
          "mode": "live", "intervalSeconds": 300, "timeoutSeconds": 120, "cohort": "onedrive-global",
          "serviceHealth": true,
          "executionLanes": [
            { "name": "user-drive", "intervalSeconds": 300, "timeoutSeconds": 120, "journeys": ["user-drive-roundtrip"] },
            { "name": "app-folder", "intervalSeconds": 300, "timeoutSeconds": 120, "journeys": ["app-folder-lifecycle"] },
            { "name": "versions", "intervalSeconds": 300, "timeoutSeconds": 120, "journeys": ["document-versions"] }
          ]
        },
        "worker": { "appName": "m365-ctbcoa-onedrive", "identity": "uami-m365-experience-consto-onedrive" },
        "scenarios": { "user-drive-roundtrip": true, "app-folder-lifecycle": true, "document-versions": true },
        "targets": [
          { "id": "onedrive-probe-001", "userPrincipalName": "test-user-1@constosuites.onmicrosoft.com", "folderName": "AHM-Synthetic-Tests", "restoreVersion": false },
          { "id": "onedrive-probe-002", "userPrincipalName": "test-user-2@constosuites.onmicrosoft.com", "folderName": "AHM-Synthetic-Tests", "restoreVersion": false }
        ]
      }
    }
  }],
  "groups": [
    {
      "id": "united-kingdom-users",
      "displayName": "United Kingdom Users",
      "accounts": ["test-user-4@constosuites.onmicrosoft.com", "test-user-5@constosuites.onmicrosoft.com"],
      "teams": ["teams-probe-002"]
    },
    {
      "id": "united-states-users",
      "displayName": "United States Users",
      "accounts": ["test-user-1@constosuites.onmicrosoft.com", "test-user-2@constosuites.onmicrosoft.com"],
      "teams": ["teams-probe-001", "teams-bot-meeting-001"]
    }
  ]
}
