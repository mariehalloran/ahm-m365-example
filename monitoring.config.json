{
  "schemaVersion": "2.0",
  "healthModel": {
    "name": "m365-experience-poc",
    "subscriptionId": "00000000-0000-0000-0000-000000000000",
    "resourceGroup": "rg-m365-demo",
    "reportTtlMinutes": 15,
    "successDegradedPercent": 99,
    "successUnhealthyPercent": 95,
    "latencyDegradedMilliseconds": 15000,
    "latencyUnhealthyMilliseconds": 60000
  },
  "deployment": {
    "location": "eastus2",
    "azureTenantId": "11111111-1111-4111-8111-111111111111",
    "enableLiveProbes": false,
    "foundation": { "mode": "create", "environmentName": "cae-m365-experience-poc", "registryName": "crm365example" },
    "image": { "mode": "build", "repository": "m365-synthetic", "tag": "monitoring" }
  },
  "otel": { "enabled": false },
  "serviceHealth": { "enabled": false },
  "tenants": [{
    "id": "contoso",
    "displayName": "Example tenant",
    "tenantId": "11111111-1111-4111-8111-111111111111",
    "services": {
      "exchange": {
        "enabled": true,
        "execution": {
          "mode": "simulation", "intervalSeconds": 60, "timeoutSeconds": 15, "cohort": "exchange-global",
          "executionLanes": [
            { "name": "mail", "intervalSeconds": 60, "timeoutSeconds": 15, "journeys": ["send-receive-mail"] },
            { "name": "extended", "intervalSeconds": 300, "timeoutSeconds": 15, "journeys": [
              "edit-reopen-draft", "attachment-mail", "reply-mail", "distribution-list-mail", "recurring-calendar", "meeting-invitation"
            ] }
          ]
        },
        "worker": { "appName": "m365-example-exchange", "identityName": "uami-m365-experience-poc-exchange" },
        "scenarios": {
          "send-receive-mail": true, "edit-reopen-draft": true, "attachment-mail": true,
          "reply-mail": true, "distribution-list-mail": true, "recurring-calendar": true, "meeting-invitation": true
        },
        "targets": [
          {
            "id": "exchange-probe-001", "mailbox": "test-user-1@example.invalid",
            "recipientMailbox": "test-user-2@example.invalid",
            "distributionList": {
              "address": "dedicated-list@example.invalid",
              "expectedRecipients": ["test-user-1@example.invalid", "test-user-2@example.invalid"]
            }
          },
          {
            "id": "exchange-probe-002", "mailbox": "test-user-2@example.invalid",
            "recipientMailbox": "test-user-1@example.invalid",
            "distributionList": {
              "address": "dedicated-list@example.invalid",
              "expectedRecipients": ["test-user-1@example.invalid", "test-user-2@example.invalid"]
            }
          }
        ]
      },
      "teams": {
        "enabled": true,
        "execution": {
          "mode": "simulation", "intervalSeconds": 120, "timeoutSeconds": 45, "cohort": "teams-global",
          "executionLanes": [
            { "name": "teams", "intervalSeconds": 120, "timeoutSeconds": 45, "journeys": ["channel-conversation", "scheduled-meeting"] }
          ]
        },
        "worker": { "appName": "m365-example-teams", "identityName": "uami-m365-experience-poc-teams" },
        "scenarios": { "channel-conversation": true, "scheduled-meeting": true },
        "targets": [{
          "id": "teams-probe-001", "tenantId": "11111111-1111-4111-8111-111111111111",
          "teamId": "33333333-3333-4333-8333-333333333333",
          "channelId": "replace-with-dedicated-standard-channel-id",
          "serviceUrl": "https://smba.trafficmanager.net/teams/"
        }],
        "callTargets": [{
          "id": "teams-meeting-001", "tenantId": "11111111-1111-4111-8111-111111111111",
          "meetingThreadId": "19:meeting_DEDICATED_TEST_MEETING@thread.v2",
          "organizerUserId": "44444444-4444-4444-8444-444444444444",
          "peerBotClientId": "22222222-2222-4222-8222-222222222222"
        }]
      },
      "onedrive": {
        "enabled": true,
        "execution": {
          "mode": "simulation", "intervalSeconds": 300, "timeoutSeconds": 120, "cohort": "onedrive-global",
          "executionLanes": [
            { "name": "user-drive", "intervalSeconds": 300, "timeoutSeconds": 120, "journeys": ["user-drive-roundtrip"] },
            { "name": "app-folder", "intervalSeconds": 300, "timeoutSeconds": 120, "journeys": ["app-folder-lifecycle"] },
            { "name": "versions", "intervalSeconds": 300, "timeoutSeconds": 120, "journeys": ["document-versions"] }
          ]
        },
        "worker": { "appName": "m365-example-onedrive", "identityName": "uami-m365-experience-poc-onedrive" },
        "scenarios": { "user-drive-roundtrip": true, "app-folder-lifecycle": true, "document-versions": true },
        "targets": [
          {
            "id": "onedrive-probe-001", "userId": "55555555-5555-4555-8555-555555555555",
            "userPrincipalName": "test-user-1@example.invalid", "folderName": "AHM-Synthetic-Tests", "restoreVersion": false
          },
          {
            "id": "onedrive-probe-002", "userId": "66666666-6666-4666-8666-666666666666",
            "userPrincipalName": "test-user-2@example.invalid", "folderName": "AHM-Synthetic-Tests", "restoreVersion": false
          }
        ]
      }
    }
  }],
  "groups": [
    {
      "id": "centralus",
      "displayName": "Central US",
      "accounts": ["test-user-1@example.invalid"],
      "teams": ["teams-probe-001", "teams-meeting-001"]
    },
    {
      "id": "uksouth",
      "displayName": "UK South",
      "accounts": ["test-user-2@example.invalid"]
    }
  ]
}
