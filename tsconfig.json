{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": [
    "telemetry/src/**/*.ts", "telemetry/tests/**/*.ts",
    "probes/*/src/**/*.ts", "probes/*/tests/**/*.ts", "probes/src/**/*.ts",
    "runner/src/**/*.ts", "runner/tests/**/*.ts",
    "shared/src/**/*.ts", "shared/tests/**/*.ts",
    "vitest.config.ts"
  ]
}
