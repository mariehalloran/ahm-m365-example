{
  "name": "m365-synthetic-health-model",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tenant-specific Microsoft 365 synthetics for Azure Monitor Health Models",
  "engines": {
    "node": ">=22 <25"
  },
  "main": "dist/runner/src/cli.js",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "tsx runner/src/cli.ts",
    "start": "node dist/runner/src/cli.js"
  },
  "dependencies": {
    "@azure/identity": "^4.12.0",
    "@azure/storage-blob": "^12.28.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
