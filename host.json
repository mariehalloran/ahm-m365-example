{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "functionTimeout": "00:04:00",
  "logging": {
    "applicationInsights": {
      "samplingSettings": { "isEnabled": false },
      "enableLiveMetricsFilters": true
    },
    "logLevel": { "default": "Information", "Host.Results": "Information" }
  }
}
