AppMetrics
| where _ResourceId =~ "__APPLICATION_INSIGHTS_RESOURCE_ID__"
| where TimeGenerated between (ago(15m) .. now())
| where Name == "synthetic.step.duration"
| where tostring(Properties["probe.service"]) == "sharepoint" and tostring(Properties["probe.mode"]) == "live"
| where tostring(Properties["probe.journey"]) == "save-reopen-file" and tostring(Properties["probe.step"]) == "__STEP__"
| summarize DurationSeconds = sum(Sum), Samples = sum(ItemCount)
| where Samples > 0
| project Value = 1000.0 * DurationSeconds / Samples
